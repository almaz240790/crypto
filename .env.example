# Скопируйте в .env и заполните. .env не коммитится.
DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/platform
REDIS_URL=redis://localhost:6379/0
APP_ENV=local
# Ключи бирж для загрузки истории не нужны: Binance Data Vision и публичный REST работают без ключа.

# Оплата (этап 3.1). Пока BILLING_ENABLED=false все пользователи на уровне Pro.
BILLING_ENABLED=false
API_PUBLIC_URL=http://localhost:8000
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# LLM-шлюз (план 2A.10.3, этап 2B.14). Выключен, пока владелец не утвердит промпт
# apps/llm-gateway/prompts/explain_pattern.v1.md и не задаст ключ Anthropic.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL_EXPLAIN=claude-haiku-5-5
LLM_MODEL_QUESTION=claude-sonnet-5-5
LLM_DAILY_BUDGET_USD=15

# Вход в админку (ADR-0011). OWNER_EMAILS — адреса владельцев через запятую (роль owner после подтверждения
# почты). PROXY_SECRET — одна и та же случайная строка у сервисов api и web: API берёт адрес клиента у прокси
# сайта и открывает /v1/admin/* только через сайт. Пусто — как раньше (адрес из X-Forwarded-For).
OWNER_EMAILS=
PROXY_SECRET=
